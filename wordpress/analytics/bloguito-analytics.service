[Unit]
Description=Bloguito private analytics HTTPS ingestion
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/agent-publisher
EnvironmentFile=/etc/bloguito-analytics.env
ExecStart=/home/ubuntu/agent-publisher/venv/bin/python /home/ubuntu/agent-publisher/analytics_http_receiver.py
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/agent-publisher/data/analytics

[Install]
WantedBy=multi-user.target
