{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bloguito critical fact annual-rule data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_id",
    "year",
    "official_hosts",
    "required_source_tokens",
    "required_source_any_groups",
    "stale_vaccine_tokens",
    "stale_schedule_tokens",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "rule_id": {"type": "string", "minLength": 1},
    "year": {"type": "integer", "minimum": 2000},
    "official_hosts": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "required_source_tokens": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "required_source_any_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "stale_vaccine_tokens": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "stale_schedule_tokens": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "reason_codes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_missing", "outdated_vaccine", "outdated_schedule"],
      "properties": {
        "source_missing": {"type": "string", "minLength": 1},
        "outdated_vaccine": {"type": "string", "minLength": 1},
        "outdated_schedule": {"type": "string", "minLength": 1}
      }
    }
  }
}
