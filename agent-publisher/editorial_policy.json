{
  "version": 1,
  "default_status": "draft",
  "min_remaining_days": 30,
  "permalink_policy": {
    "new_post_scheme": "post-id-v1",
    "new_post_path": "/p/{post_id}/",
    "preserve_existing_public_urls": true
  },
  "source_max_age_hours": 24,
  "review_max_age_hours": 24,
  "max_revisions": 2,
  "seo_guidance": {
    "rank_math_target_floor": 75,
    "rank_math_good_floor": 80,
    "rank_math_low_score_threshold": 50,
    "rank_math_is_publish_gate": false
  },
  "featured_image_policy": {
    "version": 4,
    "purpose": "modern_editorial_cover",
    "benchmark": "post-475-movein-cover-2026-09-27",
    "scope": {
      "applies_to": [
        "lookup",
        "application",
        "calculator",
        "comparison",
        "welfare",
        "pension",
        "health",
        "administrative_service"
      ],
      "exceptions": [
        "concert_poster",
        "reviewed_official_poster_preservation"
      ]
    },
    "canvas": {
      "width": 1200,
      "height": 675,
      "aspect_ratio": "16:9"
    },
    "text": {
      "max_blocks": 3,
      "chip_max_lines": 1,
      "primary_max_lines": 2,
      "secondary_max_lines": 1,
      "primary_max_chars": 22,
      "secondary_max_chars": 28,
      "avoid_full_article_title_repetition": true,
      "single_topic_word_may_match_article_title": true,
      "lists_in_image": false,
      "semantic_line_breaks_required": true,
      "line_break_strategy": "fixed_semantic_plan",
      "font_metrics_may_not_change_line_breaks": true,
      "primary_line_target_chars": 10,
      "primary_line_slot_px": 96,
      "primary_baseline_offset_px": 82,
      "secondary_line_slot_px": 36,
      "secondary_baseline_offset_px": 30,
      "primary_min_font_size_px": 52,
      "secondary_min_font_size_px": 22,
      "chip_min_font_size_px": 16,
      "overflow_behavior": "shrink_same_lines_then_reject",
      "primary_font_role": "hangul_display",
      "display_font_required": true,
      "generic_system_fonts_prohibited_for_all_visible_copy": true,
      "avoid_generic_system_font_for_primary": true,
      "brand_primary_font_family": "NotoSerifKR-900",
      "brand_primary_font_rotation": false,
      "secondary_font_role": "hangul_display",
      "brand_secondary_font_family": "NotoSerifKR-900",
      "chip_font_role": "hangul_display",
      "brand_chip_font_family": "NotoSerifKR-900",
      "candidate_font_families": [
        "HanSantteutDotum-Bold",
        "BlackHanSans",
        "DoHyeon",
        "Jua",
        "Hahmlet-900",
        "HYHeadLine-Medium",
        "HYGraphic-Medium",
        "HancomMalangMalang-Bold",
        "NotoSerifKR-900"
      ],
      "excluded_font_families": [
        "HYPMokGak-Bold",
        "Gasoek One",
        "HYShortSamul-Medium",
        "HYGungSo-Bold",
        "Headline R",
        "한컴 훈민정음_H",
        "Magic R"
      ],
      "primary_larger_than_previous_default": true
    },
    "composition": {
      "single_primary_subject": true,
      "safe_margin_percent": 8,
      "text_side": "left",
      "scene_side": "right",
      "text_vertical_alignment": "center",
      "top_aligned_text_prohibited": true,
      "text_area_percent": 45,
      "text_area_percent_range": [
        44,
        46
      ],
      "scene_area_percent": 55,
      "scene_area_percent_range": [
        54,
        56
      ],
      "text_start_px": 96,
      "text_block_center_y_percent": 50,
      "reserved_text_area_percent": 45,
      "generous_whitespace": true,
      "mobile_thumbnail_readability_required": true
    },
    "style": [
      "modern",
      "minimal",
      "editorial",
      "high_quality",
      "natural_lighting",
      "clean_layout",
      "clear_focal_subject"
    ],
    "prohibited": [
      "old_web_banner",
      "flyer",
      "government_pamphlet_look",
      "clipart_collage",
      "multiple_3d_icons",
      "badge_or_ribbon_stacks",
      "heavy_glossy_shadows",
      "excessive_gradients",
      "text_heavy_infographic",
      "crowded_checklist",
      "cropped_face_head_hands",
      "malformed_anatomy",
      "tiny_decorative_text",
      "icon_row_or_icon_grid",
      "coin_row_or_cash_pile",
      "excessive_arrows",
      "boxed_infographic_layout",
      "ppt_clipart_look"
    ],
    "color": {
      "max_main_colors": 3,
      "background": "bright",
      "brand_primary": "navy",
      "brand_accent": "green",
      "prefer_size_spacing_over_extra_accent_colors": true
    },
    "topic_profiles": {
      "events": "Show one recognizable local outing or festival scene with people naturally enjoying the place. Avoid concert-poster composition unless the article is actually about one ticketed performance.",
      "life_admin": "Use a coherent scene tied to the task, such as a person, home, laptop or smartphone, document or service action. Avoid icon grids and government-pamphlet layouts.",
      "price_compare": "Use one real product or service context with a receipt, card, price tag or comparison cue. At most one representative number may be used when separately reviewed; do not list prices.",
      "welfare": "Show the applicant, application action or everyday life context. Avoid cash piles, gold coins and money-first clichés.",
      "concert": "Prefer a separately reviewed official promotional image. Preserve artist face, full head/chin, performance title and atmosphere; use fit/background extension instead of destructive center crop.",
      "health": "Use a calm, credible Korean healthcare or wellness scene tied to the task, such as a checkup, clinic, pharmacy or vaccination context. Avoid alarming medical imagery.",
      "transport": "Use one clear mobility scene tied to the task, such as a train, bus, airport, road, vehicle inspection or parking context. Avoid generic vehicle collages.",
      "finance": "Use an everyday household-finance scene such as a card, account, insurance document, payslip or calculator in context. Avoid cash piles, investment-trading clichés and exaggerated wealth imagery.",
      "tax": "Use a practical tax-payment, filing or refund context with a laptop, document or calculator. Avoid government-pamphlet layouts and money-first clichés.",
      "life_service": "Use one clear everyday subject directly connected to the topic in a natural Korean home, desk, shop, health or service setting."
    },
    "prompt_order": [
      "purpose",
      "topic",
      "main_subject",
      "composition",
      "text",
      "style",
      "prohibited"
    ],
    "generation": {
      "scene_without_text": true,
      "overlay_korean_text_locally": true,
      "default_model": "gemini-3.1-flash-image",
      "image_size": "1K",
      "model_env_override": "BLOGUITO_IMAGE_MODEL",
      "fallback": "reject_generation_failure",
      "publishable_low_quality_fallback": false,
      "max_generation_attempts": 2
    },
    "visual_review": {
      "required_for_generated_scene": true,
      "required_for_official_poster": true,
      "default_model": "gemini-3.5-flash",
      "model_env_override": "BLOGUITO_IMAGE_REVIEW_MODEL",
      "on_unavailable": "reject_nondeterministic_image"
    },
    "event_post_override": {
      "layout_mode": "candidate_gallery",
      "minimum_layout_candidates": 5,
      "same_layout_font_variants_count_as_separate_candidates": false,
      "selected_layout_may_override_default_left_right_composition": true
    },
    "concert_source_priority": [
      "official_ticket_vendor",
      "official_promoter",
      "artist_official"
    ],
    "review_checks": [
      "topic_recognizable_at_a_glance",
      "single_clear_focal_subject",
      "text_not_overcrowded",
      "korean_text_exact",
      "semantic_line_breaks",
      "left_text_block_vertically_centered",
      "right_single_scene",
      "no_face_or_subject_crop",
      "mobile_readable",
      "desktop_balanced",
      "not_old_web_banner_or_flyer",
      "does_not_repeat_long_article_title"
    ],
    "regenerate_on": [
      "face_crop",
      "text_error",
      "malformed_person_or_hands",
      "text_overcrowding",
      "low_quality_clipart",
      "old_fashioned_banner_design"
    ]
  },
  "writer_model": "gemini-3.5-flash",
  "reviewer_model": "gemini-3.5-flash",
  "review_checks": [
    "source_support",
    "conditions_preserved",
    "question_answered",
    "useful_lifetime",
    "no_reader_deflection",
    "no_unsupported_claims"
  ],
  "blocked_patterns": [
    "(?:공식\\s*(?:안내|홈페이지|사이트)|상품\\s*페이지|위\\s*표).{0,25}(?:확인|참고)하세요",
    "보장하지\\s*않습니다",
    "(?:신청|접수)기간\\s*안에\\s*해당",
    "이\\s*글.{0,20}(?:판단|확정)할\\s*수\\s*없",
    "공식\\s*자료\\s*확인\\s*[:：]",
    "(?:첨부(?:자료|파일)|참고\\s*\\d+).{0,110}(?:찾(?:고|아|으)|대조|확인하|참고하)",
    "(?:공식\\s*(?:홈페이지|사이트|공고|자료|문서)|(?:원문|보도자료)).{0,70}(?:직접\\s*)?(?:찾아보|확인하세|참고하세|읽어보)"
  ]
}
