# PROPOSAL ONLY: place in a reviewed sshd_config.d file after checking Ubuntu
# sshd Include ordering. Validate with sshd -t and sshd -T -C user=...,host=...,addr=...
# Keep existing admin ubuntu access and independent Tailscale recovery active.
Match User bloguito-ssh-read
    ForceCommand /usr/local/libexec/bloguito/ssh_gate.py
    AuthorizedKeysFile /etc/ssh/authorized_keys/%u
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    PubkeyAuthentication yes
    PermitUserEnvironment no
    PermitTTY no
    AllowTcpForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTunnel no
    PermitUserRC no
